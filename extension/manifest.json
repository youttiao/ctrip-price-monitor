{
  "manifest_version": 3,
  "name": "携程哨兵 · 采集器",
  "version": "0.2.2",
  "description": "采集携程 H5 页面的 POI 货架与价格数据，同步到自己的 dashboard。",
  "permissions": [
    "storage",
    "cookies",
    "alarms"
  ],
  "host_permissions": [
    "https://m.ctrip.com/*",
    "https://*.ctrip.com/*",
    "http://*/*",
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://m.ctrip.com/*",
        "https://*.ctrip.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "携程哨兵 · 采集器"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}